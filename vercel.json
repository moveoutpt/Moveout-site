{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/privacy-policy/:path*", "destination": "/privacidade", "permanent": true },
    { "source": "/politica-de-privacidade/:path*", "destination": "/privacidade", "permanent": true },
    { "source": "/contact/:path*", "destination": "/contacto", "permanent": true },
    { "source": "/contactos/:path*", "destination": "/contacto", "permanent": true },
    { "source": "/loja/:path*", "destination": "/", "permanent": true },
    { "source": "/shop/:path*", "destination": "/", "permanent": true },
    { "source": "/product/:path*", "destination": "/", "permanent": true },
    { "source": "/product-category/:path*", "destination": "/", "permanent": true },
    { "source": "/carrinho/:path*", "destination": "/", "permanent": true },
    { "source": "/cart/:path*", "destination": "/", "permanent": true },
    { "source": "/finalizar-compra/:path*", "destination": "/", "permanent": true },
    { "source": "/checkout/:path*", "destination": "/", "permanent": true },
    { "source": "/minha-conta/:path*", "destination": "/", "permanent": true },
    { "source": "/refund_returns/:path*", "destination": "/", "permanent": true },
    { "source": "/courses/:path*", "destination": "/", "permanent": true },
    { "source": "/memberships/:path*", "destination": "/", "permanent": true },
    { "source": "/purchase/:path*", "destination": "/", "permanent": true },
    { "source": "/dashboard/:path*", "destination": "/", "permanent": true },
    { "source": "/painel/:path*", "destination": "/", "permanent": true },
    { "source": "/inscricao-de-alunos/:path*", "destination": "/", "permanent": true },
    { "source": "/inscricao-de-formadores/:path*", "destination": "/", "permanent": true },
    { "source": "/elementor-pagina-48/:path*", "destination": "/", "permanent": true },
    { "source": "/sample-page/:path*", "destination": "/", "permanent": true },
    { "source": "/category/:path*", "destination": "/", "permanent": true },
    { "source": "/tag/:path*", "destination": "/", "permanent": true },
    { "source": "/author/:path*", "destination": "/", "permanent": true },
    { "source": "/feed/:path*", "destination": "/", "permanent": true },
    { "source": "/comments/feed/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-login.php", "destination": "/", "permanent": false },
    { "source": "/wp-content/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
