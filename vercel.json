{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "moveout-site.vercel.app"
        }
      ],
      "destination": "https://moveoutvfx.com/:path*",
      "permanent": true
    },
    {
      "source": "/privacy-policy/:path*",
      "destination": "/privacidade",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidade/:path*",
      "destination": "/privacidade",
      "permanent": true
    },
    {
      "source": "/contact/:path*",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/contactos/:path*",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/loja/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product-category/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/carrinho/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/finalizar-compra/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkout/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/minha-conta/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/refund_returns/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/courses/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/memberships/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/purchase/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/painel/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inscricao-de-alunos/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inscricao-de-formadores/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/elementor-pagina-48/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sample-page/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}